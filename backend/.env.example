# ═══════════════════════════════════════════════════════════════════
# Basira · EHS Population Health Intelligence — SAS × EHS Agentic AI Bootcamp
# On Railway, set these under the service's Variables tab. Nothing is required to
# boot: without model credentials the app runs in direct tool mode (scenario chips
# on live data), and the SAS Copilot page runs against a mock until RAM is set.
# ═══════════════════════════════════════════════════════════════════

# ─── Language model behind the agent graph (Assistant + Simulator) ─────────────
# Auto-detected: ANTHROPIC_API_KEY first, else a Gemini credential. Without either the
# app runs in direct tool mode: scenario chips work on live data, free-form chat and the
# simulator's narrated explanation are disabled.
ANTHROPIC_API_KEY=

# Optional: a Gemini key builds the semantic guideline index (gemini-embedding-001) and can
# also serve as the model provider when ANTHROPIC_API_KEY is absent or LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto               # auto | anthropic | gemini | none
# MODEL=claude-sonnet-5           # pin a model id; otherwise the first preferred model the key can see
# MODEL_LABEL=                    # what the UI shows for the model (default "live agent graph")
# EMBED_MODEL=gemini-embedding-001
# LLM_HTTP_TIMEOUT_MS=45000       # per request; a stalled stream never hangs a turn
# FORCE_SCENARIOS=false           # true = chips always run the tools directly (demo-day safety)

# ─── Bootcamp environment links (the three buttons on the home page) ───────────
# Open in a new tab. Leave empty until the day's environments are known; the
# button then shows "link to be shared". MATERIALS_URL defaults to this repository.
VIYA_URL=
RAM_URL=
MATERIALS_URL=https://github.com/raedaldweik/Agentic-Bootcamp
# Optional: absolute URLs to hosted EHS / SAS logos, used in the header instead of the bundled EHS logo (left) and SAS logo (right)
# EHS_LOGO_URL=
# SAS_LOGO_URL=

# ─── SAS Copilot page: SAS Retrieval Agent Manager connection ──────────────────
# Base URL of the RAM API. With only RAM_API_URL set, the page shows a "Sign in"
# button and the backend auto-detects the deployment type:
#   • Standalone RAM (Keycloak)  → device code flow with PKCE (enter a short code)
#   • Full SAS Viya (SASLogon)   → authorization code flow with the sas.cli client
#     (log in, SSO included, then paste the displayed code)
# Either way the backend keeps the session alive with the refresh token.
RAM_API_URL=https://your-ram-host/SASRetrievalAgentManager/api/v1
#RAM_VERIFY_SSL=true               # false for self-signed certificates
#RAM_AUTH_FLOW=device|code         # skip auto-detection
#RAM_CLIENT_ID=sas-ram-api         # Keycloak device-flow client
#RAM_REALM=sas-iot                 # Keycloak realm
#SAS_AUTH_CLIENT_ID=sas.cli        # Viya authorization-code client
#SAS_AUTH_CLIENT_SECRET=           # only if that client has a secret

# Option A: a static bearer token (expires per your policy — demos only)
#RAM_TOKEN=eyJhbGciOi...

# Option B: a registered OAuth client — the backend fetches + refreshes tokens itself
#SAS_CLIENT_ID=ram-chat-ui
#SAS_CLIENT_SECRET=secret          # omit for a public (secret-less) client
#SAS_USERNAME=AppAdmin             # password grant; omit for client_credentials
#SAS_PASSWORD=your-password
#SAS_LOGON_URL=https://your-ram-host/SASRetrievalAgentManager/auth/realms/sas-iot/protocol/openid-connect/token

# Query behaviour: queries are submitted asynchronously and polled (no gateway 504s)
#RAM_QUERY_TIMEOUT=600             # seconds (default 600)
#RAM_QUERY_POLL_INTERVAL=2         # seconds between polls (default 2)
# Shared-identity bootcamp login? Hide RAM's shared history so teams only see their own live session
#RAM_HIDE_HISTORY=true

# Demo mode: run the SAS Copilot page against an in-memory mock, no RAM needed
RAM_MOCK=true
