# ---- Viya connection (same names as the SAS Viya MCP server) ----------------
VIYA_ENDPOINT=https://your-viya-server.com
CLIENT_ID=sas-mcp
# RAM calls the server with the participant's Viya token in the Authorization
# header. Leave this true for RAM; set false to force the browser OAuth flow.
ALLOW_RAW_BEARER=true
SSL_VERIFY=true
MCP_SIGNING_KEY=change-me-in-production
MCP_BASE_URL=
HOST_PORT=8134
COMPUTE_CONTEXT_NAME=SAS Job Execution compute context
MCP_SERVER_NAME=Bootcamp MCP Server

# ---- The scope: what this server may touch ---------------------------------
# Comma-separated caslib.table entries. Case-insensitive. * is a wildcard. Use global caslibs
# such as Public: a personal caslib (casuser) is not resolvable by the Viya data services.
ALLOWED_TABLES=Public.EHS_DIABETES,Public.EHS_FACILITIES
# Comma-separated MAS module ids (the name of the published model). * allowed.
ALLOWED_MODELS=deterioration_team1
# CAS server the tables live on.
CAS_SERVER=cas-shared-default
# Upper bound on rows a single query or preview may return (1..10000).
BOOTCAMP_MAX_ROWS=500
# Scoring step of the published module: "auto" picks "score" when the module
# has it, else "execute". Set explicitly if your module names it differently.
BOOTCAMP_SCORE_STEP=auto
